---
import Aside from "../components/article/Aside.astro";
import Box from "../components/article/Box.astro";
import Callout from "../components/article/Callout.astro";
import Comparison from "../components/article/Comparison";
import EmbedFrame from "../components/article/EmbedFrame.astro";
import EntryFooter from "../components/article/EntryFooter.astro";
import Figure from "../components/article/Figure.astro";
import FigureGrid from "../components/article/FigureGrid.astro";
import HoverNote from "../components/article/HoverNote.astro";
import ImageComparison from "../components/article/ImageComparison";
import ModelViewer from "../components/article/ModelViewer.astro";
import Picture from "../components/article/Picture.astro";
import PlotlyFigure from "../components/article/PlotlyFigure.astro";
import Proof from "../components/article/Proof.astro";
import Statement from "../components/article/Statement.astro";
import Term from "../components/article/Term.astro";
import TableOfContents from "../components/article/TableOfContents";
import ContentsSheet from "../components/article/ContentsSheet";
import Theorem from "../components/article/Theorem.astro";
import ToggleFigure from "../components/article/ToggleFigure.astro";
import ToggleFigurePanel from "../components/article/ToggleFigurePanel.astro";
import TwoColumns from "../components/article/TwoColumns.astro";
import Video from "../components/article/Video.astro";
import WrapFigure from "../components/article/WrapFigure.astro";
import YouTubeVideo from "../components/article/YouTubeVideo.astro";
import LocalGraphMap from "../components/graph/LocalGraphMap";
import { getEntryType, themeConfig, writingConfig } from "../config";
import {
  Code2,
  FileText,
  Globe,
  Image as ImageIcon,
  Link as LinkIcon,
  Play,
  Presentation,
  Tag
} from "@lucide/astro";
import { formatDate } from "../lib/dates";
import { entryToRecord } from "../lib/graph/resolveLinks";
import {
  effectiveAsides,
  resolveArticleMode,
  resolveAsides,
  resolvePlacement
} from "../lib/article/placement";
import { justifyClasses } from "../lib/article/justify";
import { relatedRepeatsLinkedFrom } from "../lib/article/linkLists";
import { filterHeadingsForToc, resolveTocConfig } from "../lib/article/toc";
import { externalLinkHref } from "../lib/publications/identifierUrls";
import type { GraphIndex, WritingEntryLike } from "../lib/graph/types";
import BaseLayout from "./BaseLayout.astro";

type Props = {
  entry: WritingEntryLike;
  graph: GraphIndex;
  headings: Array<{ depth: number; slug: string; text: string }>;
  Content: any;
};

const { entry, graph, headings, Content } = Astro.props;
const record = entryToRecord(entry);
const node = record.node;
const entryType = getEntryType(node.type);
const byId = new Map(graph.nodes.map((item) => [item.id, item]));

const articleMode = resolveArticleMode(entry);
const isAbstract = articleMode === "abstract";
const placement = resolvePlacement(entry);
const tocConfig = resolveTocConfig(entry, writingConfig);
const tocHeadings = filterHeadingsForToc(headings, tocConfig);
const asidesRequested = resolveAsides(entry);
// Abstract-mode bodies are a few paragraphs with no gutter to render
// into, so margin asides always degrade to inline there.
const asidesEffective = isAbstract
  ? "inline"
  : effectiveAsides(asidesRequested, placement.toc.where);

const justifyClass = justifyClasses(themeConfig.typography.justify, entry.data.article?.justify);
const figureNumbers = entry.data.article?.figureNumbers ?? writingConfig.entryLayout.figureNumbers;

const linksTo = graph.linksTo[node.id] ?? [];
const linkedFromIds = graph.linkedFrom[node.id] ?? [];
const relatedIds = [...new Set([...linksTo, ...linkedFromIds])].slice(0, 6);
type LinkedItem = {
  id: string;
  title: string;
  url: string;
  date?: string;
  venue?: string;
  summary?: string;
  typeLabel: string;
};
const toLinkedItem = (id: string): LinkedItem | null => {
  const item = byId.get(id);
  return item
    ? {
        id,
        title: item.title,
        url: item.url,
        date: item.date,
        venue: item.venue,
        summary: item.summary,
        typeLabel: getEntryType(item.type).label
      }
    : null;
};
const linkedFrom = linkedFromIds.map(toLinkedItem).filter((item): item is LinkedItem => item !== null);
// On a page whose links are all reciprocated (a hub and the members that link
// back to it), "Related" would list the same pages again under a second label.
const relatedCandidates = relatedIds.map(toLinkedItem).filter((item): item is LinkedItem => item !== null);
const related = relatedRepeatsLinkedFrom(relatedCandidates, linkedFrom) ? [] : relatedCandidates;
// A hub's members are what the page is for, so its "Linked from" list shows
// them as cards (year, venue, summary) rather than bare titles.
const memberCards = entryType.role === "hub" || entryType.role === "section";
const hero = entry.data.hero;
const authorsRaw = entry.data.authors ?? [];
const authors = authorsRaw.map((a) => (typeof a === "string" ? { name: a } : a));
const venue = entry.data.venue;
const hasByline = authors.length > 0 || Boolean(venue);

const chipMeta: Record<string, { label: string; icon: any }> = {
  arxiv: { label: "arXiv", icon: FileText },
  paper: { label: "Paper", icon: FileText },
  doi: { label: "DOI", icon: LinkIcon },
  code: { label: "Code", icon: Code2 },
  slides: { label: "Slides", icon: Presentation },
  poster: { label: "Poster", icon: ImageIcon },
  website: { label: "Website", icon: Globe },
  video: { label: "Video", icon: Play }
};
const external = Object.entries(entry.data.external ?? {})
  .filter(([, href]) => Boolean(href))
  .map(([key, href]) => {
    const meta = chipMeta[key] ?? { label: key, icon: LinkIcon };
    return { key, href: externalLinkHref(key, href as string), label: meta.label, Icon: meta.icon };
  });

// displayDates customizes only the header; node.date remains canonical elsewhere.
const displayDateRows = entry.data.displayDates?.map((item) => ({
  label: item.label,
  date: formatDate(item.date) ?? item.date
}));
const dateRows = displayDateRows?.length
  ? displayDateRows
  : node.date
    ? [{ date: formatDate(node.date) ?? node.date }]
    : [];

// Slot derivation. The TOC lives in either the left or right grid
// column; linkedFrom/related can also live there if explicitly placed.
// An abstract has no heading structure to outline, so the TOC is
// suppressed regardless of placement config. Linked-from, related, and
// the local graph stay put — graph context is the point of these pages.
const tocSide: "left" | "right" | "none" =
  isAbstract || placement.toc.where === "none" ? "none" : placement.toc.where;
const linkedFromSide = placement.linkedFrom.where;
const relatedSide = placement.related.where;
const localGraphInHeader = placement.localGraph.where === "header";
const localGraphInFooter = placement.localGraph.where === "footer";
const linkedFromInFooter = linkedFromSide === "footer";
const relatedInFooter = relatedSide === "footer";

const sideHasContent = (side: "left" | "right"): boolean =>
  (tocSide === side && tocHeadings.length > 0) ||
  (linkedFromSide === side && linkedFrom.length > 0) ||
  (relatedSide === side && related.length > 0);

const renderLeft = sideHasContent("left");
const renderRight = sideHasContent("right");

const renderFooter =
  localGraphInFooter || linkedFromInFooter || relatedInFooter;

const components = {
  Aside,
  Box,
  Callout,
  Comparison,
  EmbedFrame,
  Figure,
  FigureGrid,
  HoverNote,
  ImageComparison,
  ModelViewer,
  Picture,
  PlotlyFigure,
  Proof,
  Statement,
  Term,
  Theorem,
  ToggleFigure,
  ToggleFigurePanel,
  TwoColumns,
  Video,
  WrapFigure,
  YouTubeVideo
};

const renderSide = (side: "left" | "right") => ({
  toc: tocSide === side && tocHeadings.length > 0,
  linkedFrom: linkedFromSide === side && linkedFrom.length > 0,
  related: relatedSide === side && related.length > 0
});
const left = renderSide("left");
const right = renderSide("right");
---

<BaseLayout title={node.title} description={node.summary} theme={entry.data.theme} autoHideHeader>
  <article class="writing-shell">
    <div
      class="article-grid"
      data-mode={articleMode}
      data-toc={tocSide}
      data-asides={asidesEffective}
      data-has-right={renderRight ? "true" : "false"}
      data-has-foot={renderFooter ? "true" : undefined}
    >
      <header class="article-header" data-byline={hasByline ? "true" : undefined}>
        <h1>{node.title}</h1>
        {!hasByline && (
          <div class="article-meta">
            <span>{entryType.label}</span>
            {node.date && <span>{node.date}</span>}
          </div>
        )}
        {node.summary && <p class="article-summary">{node.summary}</p>}
        {node.tags.length > 0 && (
          <div class="article-tags">
            <Tag class="article-tags__icon" size={14} aria-hidden="true" />
            <span class="article-tags__label">Tags:</span>
            <span class="article-tags__list">
              {node.tags.map((tag, i) => (
                <>
                  {i > 0 && <span class="article-tags__sep">·</span>}
                  <span class="article-tags__tag">{tag}</span>
                </>
              ))}
            </span>
          </div>
        )}
        {
          external.length > 0 && (
            <div class="article-external">
              {external.map(({ href, label, Icon }) => (
                <a class="entry-chip" href={href}>
                  <Icon class="entry-chip__icon" size={14} aria-hidden="true" />
                  <span>{label}</span>
                </a>
              ))}
            </div>
          )
        }
        {
          hasByline && (
            <div class="article-byline">
              {authors.length > 0 && (
                <div class="article-byline__col">
                  <div class="article-byline__label">Authors</div>
                  <ul class="article-byline__list">
                    {authors.map((a) => (
                      <li>
                        {a.url ? <a href={a.url}>{a.name}</a> : <span>{a.name}</span>}
                        {a.note && <sup class="article-byline__note">{a.note}</sup>}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {authors.some((a) => a.affiliation) && (
                <div class="article-byline__col">
                  <div class="article-byline__label">Affiliations</div>
                  <ul class="article-byline__list">
                    {authors.map((a) => (
                      <li>{a.affiliation ?? " "}</li>
                    ))}
                  </ul>
                </div>
              )}
              {venue && (
                <div class="article-byline__col">
                  <div class="article-byline__label">Venue</div>
                  <div class="article-byline__value">{venue}</div>
                </div>
              )}
              {dateRows.length > 0 && (
                <div class="article-byline__col article-byline__col--date">
                  <div class="article-byline__label">Date</div>
                  {dateRows.length === 1 && !("label" in dateRows[0]) ? (
                    <div class="article-byline__value">{dateRows[0].date}</div>
                  ) : (
                    <ul class="article-date-list">
                      {dateRows.map((row) => (
                        <li class="article-date-list__item">
                          {"label" in row && <span class="article-date-list__label">{row.label}:</span>}
                          <span class="article-date-list__date">{row.date}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              )}
            </div>
          )
        }
        {
          localGraphInHeader && (
            <div class="article-header__graph">
              <LocalGraphMap
                client:load
                graph={graph}
                currentId={node.id}
                depth={writingConfig.entryLayout.localGraph.defaultDepth as 1 | 2}
                maxNodes={writingConfig.entryLayout.localGraph.maxNodes}
              />
            </div>
          )
        }
      </header>

      {/* The contents on narrow screens, where the sidebars collapse. */}
      {tocSide !== "none" && tocHeadings.length > 1 && (
        <ContentsSheet client:media="(max-width: 980px)" headings={headings} tocConfig={tocConfig} />
      )}

      {
        renderLeft && (
          <aside class="article-sidebar article-sidebar--left" aria-label="Article sidebar (left)">
            {left.toc && (
              <section class="sidebar-section sidebar-section--toc">
                <h2>On This Page</h2>
                <TableOfContents client:load headings={headings} tocConfig={tocConfig} />
              </section>
            )}
            {left.linkedFrom && (
              <section class="sidebar-section">
                <h2>Linked from</h2>
                <ul>
                  {linkedFrom.map((item) => (
                    <li><a href={item.url}>{item.title}</a></li>
                  ))}
                </ul>
              </section>
            )}
            {left.related && (
              <section class="sidebar-section">
                <h2>Related</h2>
                <ul>
                  {related.map((item) => (
                    <li><a href={item.url}>{item.title}</a></li>
                  ))}
                </ul>
              </section>
            )}
          </aside>
        )
      }

      <main class="article-main">
        {/* Article mode leads with the hero; abstract mode puts it after the
            abstract, so the paper's own words open the record. Placed in the
            DOM rather than reordered in CSS so reading order matches. */}
        {
          hero && !isAbstract && (
            <Figure
              class="article-hero"
              src={hero.src}
              alt={hero.alt ?? ""}
              caption={hero.caption}
            />
          )
        }
        {
          isAbstract ? (
            <section class="abstract-block" aria-label="Abstract">
              <h2 class="abstract-block__label">Abstract</h2>
              <div
                class:list={["article-content", ...justifyClass]}
                data-asides={asidesEffective}
                data-figure-numbers={figureNumbers ? "true" : undefined}
              >
                <Content components={components} />
              </div>
            </section>
          ) : (
            <div
              class:list={["article-content", ...justifyClass]}
              data-asides={asidesEffective}
              data-figure-numbers={figureNumbers ? "true" : undefined}
            >
              <Content components={components} />
            </div>
          )
        }
        {
          hero && isAbstract && (
            <Figure
              class="article-hero"
              src={hero.src}
              alt={hero.alt ?? ""}
              caption={hero.caption}
            />
          )
        }
      </main>

      {
        renderRight && (
          <aside class="article-sidebar article-sidebar--right" aria-label="Article sidebar (right)">
            {right.toc && (
              <section class="sidebar-section sidebar-section--toc">
                <h2>On This Page</h2>
                <TableOfContents client:load headings={headings} tocConfig={tocConfig} />
              </section>
            )}
            {right.linkedFrom && (
              <section class="sidebar-section">
                <h2>Linked from</h2>
                <ul>
                  {linkedFrom.map((item) => (
                    <li><a href={item.url}>{item.title}</a></li>
                  ))}
                </ul>
              </section>
            )}
            {right.related && (
              <section class="sidebar-section">
                <h2>Related</h2>
                <ul>
                  {related.map((item) => (
                    <li><a href={item.url}>{item.title}</a></li>
                  ))}
                </ul>
              </section>
            )}
          </aside>
        )
      }

      <EntryFooter
        graph={graph}
        currentId={node.id}
        headings={headings}
        tocConfig={tocConfig}
        tocInFoot={false}
        showLocalGraph={localGraphInFooter}
        linkedFrom={linkedFromInFooter ? linkedFrom : []}
        linkedFromAsCards={memberCards}
        related={relatedInFooter ? related : []}
        bibtex={(entry.data as { bibtex?: string }).bibtex}
      />
    </div>
  </article>
</BaseLayout>

<script>
  // Fade the hidden edge of display math (and BibTeX) too wide for the column.
  import { wireOverflowHints } from "../lib/article/overflowHint";

  wireOverflowHints(".article-content .katex-display, .cite-body__code");
</script>
