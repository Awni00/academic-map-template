---
import { Font } from "astro:assets";
import "katex/dist/katex.min.css";
import "../styles/globals.css";

import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import ThemeStyles from "../components/layout/ThemeStyles.astro";
import { siteConfig } from "../config/site";
import { darkTheme, lightTheme, themeConfig } from "../config/theme";
import { siteFontCssVariables } from "../site/fonts";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  theme?: "global" | "system" | "light" | "dark";
  /** Long reads: let the phone app bar slide away while scrolling down. */
  autoHideHeader?: boolean;
};

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.ogImage,
  theme = "global",
  autoHideHeader = false
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, siteConfig.url).toString();
const resolvedImage = new URL(image, siteConfig.url).toString();
/**
 * The pre-paint theme bootstrap.
 *
 * Inline and un-bundled so it runs before the first paint — a module import
 * would arrive too late and the page would flash the wrong palette. It is also
 * the whole theme toggle: `ThemeToggle.astro` is static markup that this
 * script labels and listens to, so the toggle works and shows the right icon
 * before any island hydrates, and there is one code path for every change.
 *
 * The model. The site has a default (`theme.defaultMode`, or a page's `theme`
 * frontmatter): a fixed theme, or "system" to follow the reader's OS. A reader
 * can make one choice, light or dark. Only a choice that differs from what the
 * site would show anyway is stored, so choosing the default again clears it:
 * under "system" that hands the decision back to the OS, and under a fixed
 * default a later change of default reaches every reader who went back to it.
 * On a page whose frontmatter forces a theme the choice lasts for that view
 * only, since the page will force its own theme again on the next load.
 *
 * It stamps `data-theme` (light | dark, what CSS keys on) and
 * `data-theme-source` (system | default | choice, which the toggle's icon
 * keys on) on <html>, swaps art-directed images, and sets the browser-bar
 * colour. The image swap is here rather than in a
 * `<picture media="(prefers-color-scheme: dark)">` because that media query
 * follows the operating system, so a reader on a light OS who switched the
 * site to dark kept getting the light image. The same goes for theme-color.
 */
const pageMode = theme === "global" ? null : theme;
const themeScript = `
(function () {
  var pageMode = ${JSON.stringify(pageMode)};
  var siteMode = ${JSON.stringify(themeConfig.defaultMode)};
  var canChoose = ${JSON.stringify(themeConfig.allowToggle)};
  var barColors = ${JSON.stringify({ light: lightTheme.colors.bg, dark: darkTheme.colors.bg })};
  var KEY = "theme";
  var root = document.documentElement;
  var osDark = matchMedia("(prefers-color-scheme: dark)");
  var mode = pageMode || siteMode;
  // A forced page's choice, or any choice while storage is blocked, lives
  // in \`viewChoice\` and lasts for this view only.
  var viewOnly = Boolean(pageMode);
  var viewChoice = null;

  function fallback() {
    return mode === "system" ? (osDark.matches ? "dark" : "light") : mode;
  }

  function storedChoice() {
    if (!canChoose) return null;
    if (viewOnly) return viewChoice;
    try {
      var value = localStorage.getItem(KEY);
      // Older versions also stored "system"; that is the same as no choice.
      return value === "light" || value === "dark" ? value : null;
    } catch (error) {
      viewOnly = true;
      return viewChoice;
    }
  }

  function label(button, theme, source) {
    var name = theme === "dark" ? "dark" : "light";
    var other = theme === "dark" ? "light" : "dark";
    var fromOs = source === "system" ? ", from your system setting" : "";
    button.setAttribute("aria-label", "Theme: " + name + fromOs + ". Switch to " + other + ".");
    button.setAttribute("title", (theme === "dark" ? "Dark" : "Light") + " theme" + fromOs);
  }

  function paintBody(theme, source) {
    var images = document.querySelectorAll("img[data-dark-src]");
    for (var i = 0; i < images.length; i += 1) {
      var image = images[i];
      var wanted = theme === "dark" ? image.dataset.darkSrc : image.dataset.lightSrc;
      if (wanted && image.getAttribute("src") !== wanted) image.setAttribute("src", wanted);
    }
    var buttons = document.querySelectorAll("[data-theme-toggle]");
    for (var j = 0; j < buttons.length; j += 1) label(buttons[j], theme, source);
  }

  function render() {
    var choice = storedChoice();
    var theme = choice || fallback();
    var source = choice ? "choice" : mode === "system" ? "system" : "default";
    root.dataset.theme = theme;
    root.dataset.themeSource = source;
    var bar = document.querySelector('meta[name="theme-color"]');
    if (bar) bar.setAttribute("content", barColors[theme]);
    paintBody(theme, source);
  }

  function choose(theme) {
    var choice = theme === fallback() ? null : theme;
    if (!viewOnly) {
      try {
        if (choice) localStorage.setItem(KEY, choice);
        else localStorage.removeItem(KEY);
      } catch (error) {
        viewOnly = true;
      }
    }
    viewChoice = choice;
    render();
  }

  render();

  // The body is not parsed yet when this runs in <head>.
  document.addEventListener("DOMContentLoaded", function () {
    paintBody(root.dataset.theme, root.dataset.themeSource);
  });

  document.addEventListener("click", function (event) {
    var target = event.target;
    var button = target && target.closest ? target.closest("[data-theme-toggle]") : null;
    if (button) choose(root.dataset.theme === "dark" ? "light" : "dark");
  });

  // Follow the OS while no choice is in force, even with the page open.
  osDark.addEventListener("change", render);

  // A choice made in another tab applies here too.
  window.addEventListener("storage", function (event) {
    if (event.key === KEY || event.key === null) render();
  });
})();
`;---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ThemeStyles />
    <!-- One browser-bar colour, set by the script below to the site's theme. -->
    <meta name="theme-color" content={lightTheme.colors.bg} />
    <script is:inline set:html={themeScript}></script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" />
    <Font cssVariable={siteFontCssVariables.serif} />
    <Font cssVariable={siteFontCssVariables.sans} />
    <Font cssVariable={siteFontCssVariables.mono} />
  </head>
  <body>
    <div class="site-shell">
      <a class="skip-link" href="#main">Skip to content</a>
      <Header autoHide={autoHideHeader} />
      <main id="main" class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
