---
import BaseLayout from "./BaseLayout.astro";
import Box from "../components/article/Box.astro";
import Callout from "../components/article/Callout.astro";
import Figure from "../components/article/Figure.astro";
import HoverNote from "../components/article/HoverNote.astro";
import Term from "../components/article/Term.astro";
import type { GraphIndex, EntryNode } from "../lib/graph/types";
import type { Publication } from "../lib/publications/types";
import WritingPreview from "../components/graph/WritingPreview";
import PublicationItem from "../components/publications/PublicationItem.astro";
import Hero from "../components/home/Hero.astro";
import NewsList from "../components/home/NewsList.astro";
import RecentWriting from "../components/home/RecentWriting.astro";
import { siteConfig, themeConfig } from "../config";
import { justifyClasses } from "../lib/article/justify";
import { resolveHeroLinks } from "../lib/home/hero";
import type { NewsItem } from "../lib/news/loadNews";

type Props = {
  graph: GraphIndex;
  recentWriting: EntryNode[];
  selectedPublications: Publication[];
  news: NewsItem[];
  Content: any;
  /** The home page's `article.justify` frontmatter, if set. */
  justify?: boolean;
};

const { graph, recentWriting, selectedPublications, news, Content, justify } = Astro.props;
const heroConfig = siteConfig.homepage.hero;
const heroLinks = resolveHeroLinks(heroConfig.links.show, siteConfig.links);
const previewConfig = siteConfig.homepage.writingPreview;
const components = { Box, Callout, Figure, HoverNote, Term };
const showPubs =
  siteConfig.homepage.selectedPublications.enabled && selectedPublications.length > 0;
const showRecent = siteConfig.homepage.recentWriting.enabled && recentWriting.length > 0;
const showNews = siteConfig.homepage.news.enabled && news.length > 0;
const showResearch = siteConfig.homepage.researchSummary.enabled;
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  {
    heroConfig.enabled && (
      <Hero
        hero={heroConfig}
        name={siteConfig.name}
        role={siteConfig.role}
        affiliation={siteConfig.affiliation}
        photo={siteConfig.profileImage}
        links={heroLinks}
        bioClass={justifyClasses(themeConfig.typography.justify, justify)}
      >
        {showResearch && <Content components={components} />}
      </Hero>
    )
  }

  {
    previewConfig.enabled && (
      <section class="section">
        <WritingPreview
          client:load
          graph={graph}
          title={previewConfig.title}
          description={previewConfig.description}
          clickTarget={previewConfig.clickTarget}
          filter={previewConfig.filter as any}
          maxNodes={previewConfig.maxNodes}
          previewHeight={previewConfig.previewHeight}
          desktopMode={previewConfig.desktopMode}
          mobileMode={previewConfig.mobileMode}
          interactive={previewConfig.interactive}
          hover={previewConfig.hover}
        />
      </section>
    )
  }

  {
    (showPubs || showNews) && (
      <section class="section">
        <div class={showPubs && showNews ? "cols2" : "cols2 cols2--single"}>
          {showPubs && (
            <section>
              <h2 class="h2">Selected publications</h2>
              <div class="publication-list">
                {selectedPublications.map((publication) => (
                  <PublicationItem
                    publication={publication}
                    abstractDisplay={siteConfig.homepage.selectedPublications.abstractDisplay}
                  />
                ))}
              </div>
              <a class="btn btn--outline btn--small publications-more" href="/publications">
                All publications
                <svg class="btn__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            </section>
          )}
          {showNews && (
            <aside>
              <h2 class="h2">News</h2>
              <NewsList items={news} />
            </aside>
          )}
        </div>
      </section>
    )
  }

  {
    showRecent && (
      <RecentWriting
        entries={recentWriting}
        title={siteConfig.homepage.recentWriting.title}
        viewAll={siteConfig.homepage.recentWriting.viewAll}
      />
    )
  }
</BaseLayout>
