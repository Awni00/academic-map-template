---
/**
 * TEMPORARY fixture: what a dragged node does when you let go.
 *
 * Three answers are possible — it stays, it springs back into the simulation,
 * or it stays until a gesture releases it — and the right one is not obviously
 * the same on both surfaces. The unanchored map is a free-form layout where a
 * reader rearranging things is arguably the point. The anchored map has a ring
 * radius and a scale that `anchorLayout` states as *inputs*, so a stray pin is
 * a node sitting off a circle everything else is on.
 *
 * Both are here, side by side, under one switch, with the real graph at the
 * real measures each surface uses. Delete once a behaviour is chosen.
 */
import { getCollection } from "astro:content";

import { graphConfig } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildGraphIndex } from "../lib/graph/buildGraph";
import { adjacentIds } from "../lib/graph/neighborhoods";
import NodeDragVariants from "./NodeDragVariants";

const title = "Node drag release behaviour";
const description = "Internal fixture comparing what happens when a dragged node is dropped.";

const entries = await getCollection("writing", ({ data }) => data.draft !== true);
const graph = buildGraphIndex(entries, { collectWarnings: false }).index;

// The busiest neighbourhood the corpus has: crowding is where a node left off
// the ring shows up most clearly.
const anchorId = graph.nodes
  .map((node) => ({ id: node.id, degree: adjacentIds(graph.edges, node.id).length }))
  .sort((a, b) => b.degree - a.degree)[0]?.id;
---

<BaseLayout title={title} description={description}>
  <article class="nd-page">
    <header class="page-header">
      <h1>{title}</h1>
      <p class="page-description">
        Drag a node in each canvas and let go. The switch changes what happens next. Panning is
        suppressed only while a node is in hand, so dragging the background should still pan, and a
        click should still select.
      </p>
    </header>
    {
      anchorId ? (
        <NodeDragVariants
          client:load
          graph={graph}
          anchorId={anchorId}
          hubLayout={graphConfig.layout.hubs}
          labelMode={graphConfig.layout.labels}
          labelSide={graphConfig.layout.labelSide}
        />
      ) : (
        <p>No graph nodes to drag.</p>
      )
    }
  </article>
</BaseLayout>

