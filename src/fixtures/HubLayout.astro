---
/**
 * A hub page with no intro: the real `hub-2` entry, rendered through
 * `WritingEntryLayout` with an empty body, so the page keeps hub-2's graph
 * neighbourhood (members that link back, so "Related" repeats "Linked from")
 * without a second copy of the hub in the site's graph. The populated case is
 * hub-2's own page.
 */
import { getCollection } from "astro:content";

import WritingEntryLayout from "../layouts/WritingEntryLayout.astro";
import { buildGraphIndex } from "../lib/graph/buildGraph";
import EmptyBody from "./EmptyBody.astro";

const writingEntries = await getCollection("writing", ({ data }) => data.draft !== true);
const graph = buildGraphIndex(writingEntries, { collectWarnings: false }).index;
const hub = writingEntries.find((entry) => entry.id === "hub-2" || entry.id === "hub-2/index");
---

{hub && <WritingEntryLayout entry={hub} graph={graph} headings={[]} Content={EmptyBody} />}
