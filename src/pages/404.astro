---
/**
 * The not-found page. `astro build` writes it to `dist/404.html`, which GitHub
 * Pages (and most static hosts) serve for any path that has no file. The
 * header's links are the way on, so the page itself only says what happened.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
---

<BaseLayout title="Page not found" description={`This page doesn't exist on ${siteConfig.name}'s site.`}>
  <section class="page-shell">
    <header class="page-header">
      <h1>Page not found</h1>
      <p class="page-description">The page you were looking for doesn't exist, or it has moved.</p>
    </header>
  </section>
</BaseLayout>
