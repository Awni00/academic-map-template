---
/**
 * The not-found page. `astro build` writes it to `dist/404.html`, which GitHub
 * Pages (and most static hosts) serve for any path that has no file. It lists
 * the header's links, so a reader who followed a stale URL has somewhere to go.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
---

<BaseLayout title="Page not found" description={`This page doesn't exist on ${siteConfig.name}'s site.`}>
  <section class="page-shell">
    <header class="page-header">
      <h1>Page not found</h1>
      <p class="page-description">The page you were looking for doesn't exist, or it has moved.</p>
    </header>
    <ul class="not-found-links">
      {
        siteConfig.nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: 15px;
  }
</style>
