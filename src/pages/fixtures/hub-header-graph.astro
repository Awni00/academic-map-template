---
/**
 * TEMPORARY fixture: variants for the hub top-of-page graph.
 *
 * Hub and sub-hub entries put their local graph in the article header, and
 * `EntryFooter` suppresses the footer map whenever the header has one — so on
 * these pages the header map is the *only* neighbourhood view, and it is
 * currently the weakest of the three graph widgets: unanchored, unlabelled and
 * inert. This page compares what should sit beside it.
 *
 * Real entries and the real graph, at the header's real 760px measure. Delete
 * once a variant is chosen.
 */
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildGraphIndex } from "../../lib/graph/buildGraph";
import { resolvePlacement } from "../../lib/article/placement";
import { adjacentIds } from "../../lib/graph/neighborhoods";
import HubHeaderVariants from "./_HubHeaderVariants";

const title = "Hub header graph variants";
const description = "Internal fixture comparing top-of-page graph treatments for hub entries.";

const writingEntries = await getCollection("writing", ({ data }) => data.draft !== true);
const graph = buildGraphIndex(writingEntries, { collectWarnings: false }).index;

// Ask the real resolver which entries get a header graph, rather than naming
// them — a hardcoded list would silently diverge from what ships the moment a
// type default or a frontmatter override changed.
const headerEntries = writingEntries.filter(
  (entry) => resolvePlacement(entry).localGraph.where === "header"
);
const headerIds = new Set(headerEntries.map((entry) => entry.id.replace(/\/?index$/, "")));

const cases = graph.nodes
  .filter((node) => headerIds.has(node.id))
  .map((node) => ({
    id: node.id,
    title: node.title,
    neighbours: adjacentIds(graph.edges, node.id).length,
    depth: 1 as const
  }))
  .sort((a, b) => b.neighbours - a.neighbours);

// With 1–7 neighbours the crowding branch never fires. Depth 2 on the densest
// hub is the most real data can offer — and it only reaches 8, because that
// hub's component of the graph is genuinely that small.
const densest = cases[0];
const stress = densest ? [{ ...densest, depth: 2 as const }] : [];

// So the crowded case is made up, and labelled as such. `maxNodes` caps a
// neighbourhood at 20, and past roughly 11 the ring has to grow and the scale
// starts to give — the branch is unreachable with this corpus but perfectly
// reachable on a real site, and shipping it unseen is how the last bug got in.
const SYNTHETIC_TYPES = ["paper", "note", "project", "teaching", "post", "sub-hub"];
const syntheticNeighbours = Array.from({ length: 20 }, (_, i) => ({
  id: `synthetic-${i}`,
  path: `synthetic-${i}`,
  slug: `synthetic-${i}`,
  title: `Neighbour ${i + 1}`,
  type: SYNTHETIC_TYPES[i % SYNTHETIC_TYPES.length],
  tags: [],
  url: "#"
}));
const syntheticCentre = {
  id: "synthetic-hub",
  path: "synthetic-hub",
  slug: "synthetic-hub",
  title: "Crowded hub",
  type: "hub",
  tags: [],
  url: "#",
  summary: "A made-up neighbourhood at the maxNodes cap, to exercise crowding."
};
const syntheticGraph = {
  nodes: [syntheticCentre, ...syntheticNeighbours],
  edges: syntheticNeighbours.map((n) => ({ source: syntheticCentre.id, target: n.id })),
  backlinks: Object.fromEntries(syntheticNeighbours.map((n) => [n.id, [syntheticCentre.id]])),
  outgoing: { [syntheticCentre.id]: syntheticNeighbours.map((n) => n.id) },
  hubs: [syntheticCentre]
} as any;
const crowded = [
  {
    id: syntheticCentre.id,
    title: syntheticCentre.title,
    neighbours: syntheticNeighbours.length,
    depth: 1 as const,
    graph: syntheticGraph,
    synthetic: "made-up data, at the maxNodes cap"
  }
];
---

<BaseLayout title={title} description={description}>
  <article class="hv-page">
    <header class="page-header">
      <h1>{title}</h1>
      <p class="page-description">
        Hub pages put their map in the header, and the footer map is suppressed when they do — so
        this is the only neighbourhood view those pages have. Ring geometry is settled; what varies
        here is what sits beside it. Every cell is the real 760px header measure with real data.
      </p>
    </header>

    {
      cases.length === 0 ? (
        <p class="hv-empty">
          No entry currently resolves to <code>localGraph.where === "header"</code>.
        </p>
      ) : (
        <HubHeaderVariants client:load graph={graph} cases={[...cases, ...stress, ...crowded]} />
      )
    }
  </article>
</BaseLayout>

<style is:global>
  /* The article header's real measure — NOT .page-shell, which is 720px and
     would make every comparison here 40px narrower than what ships. */
  .hv-page {
    width: min(100% - 2rem, 760px);
    margin: 0 auto;
    padding: 56px 0 72px;
  }
  .hv-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin: 28px 0 20px;
    padding: 14px 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  .hv-toggle {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: 12.5px;
    color: var(--color-fg);
  }
  .hv-toggle span {
    display: flex;
    flex-direction: column;
  }
  .hv-toggle small,
  .hv-hint {
    font-size: 11px;
    color: var(--color-muted);
  }
  .hv-hint {
    margin: 0;
    font-family: var(--font-ui);
  }
  .hv-verdict {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 16px;
    margin-bottom: 24px;
    background: var(--color-bg-soft);
    border-radius: 6px;
    border-left: 3px solid var(--color-border);
  }
  .hv-verdict.is-good {
    border-left-color: var(--color-success);
  }
  .hv-verdict__figure {
    font-family: var(--font-mono);
    font-size: 26px;
    font-weight: 600;
    min-width: 88px;
    color: var(--color-fg);
  }
  .hv-verdict__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-ui);
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .hv-verdict__body strong {
    font-size: 13px;
    color: var(--color-fg);
  }
  .hv-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 11.5px;
    margin-bottom: 44px;
  }
  .hv-table th {
    text-align: left;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 10px;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-rule);
    padding: 6px 8px 6px 0;
  }
  .hv-table td {
    padding: 5px 8px 5px 0;
    border-bottom: 1px dashed var(--color-border-soft);
    color: var(--color-fg-soft);
  }
  .hv-table .is-degraded {
    color: var(--color-warning);
  }
  .hv-stress {
    color: var(--color-warning);
  }
  .hv-group {
    margin: 0 0 40px;
  }
  .hv-group h2 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-ui);
    font-size: 15px;
    margin: 0 0 4px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-border);
  }
  .hv-group__meta {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .hv-cell {
    margin: 0 0 28px;
  }
  .hv-cell figcaption {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin-bottom: 4px;
  }
  .hv-cell__label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg);
  }
  .hv-cell__note {
    font-family: var(--font-ui);
    font-size: 11.5px;
    color: var(--color-muted);
  }
  /* The header's own spacing above the graph slot. */
  .hv-slot {
    margin-top: 24px;
  }
  .hv-empty {
    font-family: var(--font-ui);
    color: var(--color-muted);
  }
</style>
