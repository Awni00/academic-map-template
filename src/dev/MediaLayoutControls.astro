---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmbedFrame from "../components/article/EmbedFrame.astro";
import Figure from "../components/article/Figure.astro";
import FigureGrid from "../components/article/FigureGrid.astro";
import ImageComparison from "../components/article/ImageComparison";
import Picture from "../components/article/Picture.astro";
import PlotlyFigure from "../components/article/PlotlyFigure.astro";
import TwoColumns from "../components/article/TwoColumns.astro";

const title = "Media Layout Controls Fixture";
const description = "Internal fixture page for template media layout controls.";
---

<BaseLayout title={title} description={description}>
  <article class="page-shell">
    <header class="page-header">
      <h1 id="media-layout-controls-fixture">{title}</h1>
      <p class="page-description">{description}</p>
    </header>
    <div class="article-content">
      <FigureGrid
        class="fixture-equal-grid"
        columns={2}
        equalFrames
        mediaAspectRatio="3 / 2"
        mediaFit="contain"
        gap="1.25rem"
        caption="Fixture grid with equal media frames."
      >
        <Figure
          src="/figures/example-chart.svg"
          alt="Example chart fixture."
          caption="Source figure through the Figure src prop."
        />
        <Figure mediaInset="0.75rem">
          <Picture
            slot="figure"
            class="fixture-picture"
            style="--fixture-style-token: 1;"
            src="/figures/example-grid.svg"
            alt="Example grid fixture with a direct Picture class and style."
            invertInDarkMode
          />
          <Fragment slot="caption">Slotted Picture with a per-figure media inset.</Fragment>
        </Figure>
      </FigureGrid>

      <PlotlyFigure
        class="fixture-plotly"
        src="/figures/demo-plotly-example-scatter.html"
        iframeTitle="Fixture Plotly figure"
        caption="Plotly figure with the legacy height prop."
        height="480px"
        showOpenLink={false}
      />

      <EmbedFrame
        class="fixture-embed"
        src="/figures/demo-plotly-example-bars.html"
        title="Fixture embedded figure"
        caption="EmbedFrame with the legacy height prop."
        height="360px"
        showOpenLink={false}
      />

      <EmbedFrame
        class="fixture-embed-autofit"
        src="/figures/fixture-autofit-embed.html"
        title="Fixture auto-fit embedded figure"
        caption="EmbedFrame that auto-fits to its content height."
        height="360px"
        autoFit
        invertInDarkMode
        showOpenLink={false}
      />

      <ImageComparison
        client:idle
        className="fixture-image-comparison"
        leftSrc="/figures/example-chart.svg"
        rightSrc="/figures/example-grid.svg"
        leftAlt="Example chart fixture."
        rightAlt="Example grid fixture."
        mediaAspectRatio="3 / 2"
        mediaInset="0.25rem"
        showLabels={false}
      />

      <TwoColumns class="fixture-two-columns" gap="2rem" align="start">
        <Fragment slot="left">
          <p>Left fixture column.</p>
        </Fragment>
        <Fragment slot="right">
          <p>Right fixture column.</p>
        </Fragment>
      </TwoColumns>
    </div>
  </article>
</BaseLayout>
