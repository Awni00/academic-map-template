---
import {
  BookOpen,
  Braces,
  Check,
  CodeXml,
  Copy,
  FileCode,
  FileText,
  Globe,
  Image as ImageIcon,
  Link as LinkIcon,
  PenLine,
  Play,
  Presentation,
  Star,
  TextAlignStart,
  X
} from "@lucide/astro";
import { publicationsConfig } from "../../config";
import { renderInlineMath } from "../../lib/math/inlineMath";
import { resolveMathMacros } from "../../lib/math/resolve";
import {
  highlightedAuthorParts,
  publicationLinks,
  type PublicationLinkKind
} from "../../lib/publications/formatPublication";
import { globalMathMacros } from "../../site/math";
import type { PublicationAbstractDisplay } from "../../config/types";
import type { Publication } from "../../lib/publications/types";

type Props = {
  publication: Publication;
  compact?: boolean;
  abstractDisplay?: PublicationAbstractDisplay;
};

const { publication, compact = false, abstractDisplay = "popup" } = Astro.props;
const links = publicationLinks(publication);
const linkIcons: Record<PublicationLinkKind, typeof FileText> = {
  pdf: FileText,
  arxiv: FileText,
  html: FileCode,
  code: CodeXml,
  blog: PenLine,
  slides: Presentation,
  poster: ImageIcon,
  video: Play,
  website: Globe,
  publisher: BookOpen,
  doi: LinkIcon,
  url: LinkIcon
};
const authorParts = highlightedAuthorParts(publication.author);
const thumbHref =
  publication.pdf ?? publication.url ?? publication.publisherPage ?? publication.website ?? undefined;
const effectiveAbstractDisplay: PublicationAbstractDisplay = compact ? "hidden" : abstractDisplay;
const showInlineAbstract = Boolean(publication.abstract) && effectiveAbstractDisplay === "inline";
const showAbstractButton = Boolean(publication.abstract) && effectiveAbstractDisplay === "popup";
const abstractDialogId = `abstract-${publication.id}`;
// BibTeX abstracts never pass through the Markdown pipeline, so their math is
// typeset here, with the same site macros articles get.
const abstractHtml =
  publication.abstract && publicationsConfig.abstractMath
    ? renderInlineMath(publication.abstract, resolveMathMacros({ globalMacros: globalMathMacros }))
    : undefined;
const dialogId = `bib-${publication.id}`;
// One block per line, so a long field wraps under its own value (hanging
// indent) instead of scrolling sideways on a phone.
const bibtexLines = publication.bibtex.split("\n");
---

<article class:list={["publication-item", compact && "publication-item--compact"]}>
  {!compact && (
    thumbHref ? (
      <a href={thumbHref} class="publication-preview" aria-hidden="true" tabindex="-1">
        {publication.preview ? (
          <img src={publication.preview} alt="" loading="lazy" />
        ) : (
          <div class="publication-thumb-fallback" />
        )}
        {publication.abbr && <span class="publication-thumb-tag">{publication.abbr}</span>}
      </a>
    ) : (
      <div class="publication-preview" aria-hidden="true">
        {publication.preview ? (
          <img src={publication.preview} alt="" loading="lazy" />
        ) : (
          <div class="publication-thumb-fallback" />
        )}
        {publication.abbr && <span class="publication-thumb-tag">{publication.abbr}</span>}
      </div>
    )
  )}
  <div class="publication-body">
    <h3>{publication.title}</h3>
    <p class="publication-authors">
      {
        authorParts.map((part) =>
          part.highlighted ? <strong>{part.text}</strong> : <span>{part.text}</span>
        )
      }
    </p>
    <p class="publication-venue">
      {publication.venue ? <i>{publication.venue}</i> : publication.type}, {publication.year}
      {publication.award && (
        <span class="publication-award"><Star aria-hidden="true" />{publication.award}</span>
      )}
    </p>
    {showInlineAbstract && (
      abstractHtml ? (
        <p class="publication-abstract" set:html={abstractHtml} />
      ) : (
        <p class="publication-abstract">{publication.abstract}</p>
      )
    )}
    {(links.length > 0 || showAbstractButton || publication.bibtexShow) && (
      <div class="publication-links">
        {links.length > 0 && (
          <div class="publication-links__group">
            {links.map((link) => {
              const Icon = linkIcons[link.kind];
              return (
                <a class="publication-link" href={link.href}>
                  <Icon aria-hidden="true" />
                  {link.label}
                </a>
              );
            })}
          </div>
        )}
        {(showAbstractButton || publication.bibtexShow) && (
          <div class="publication-links__group publication-links__group--toggles">
            {showAbstractButton && (
              <button
                type="button"
                class="publication-link publication-link--button"
                data-dialog-open={abstractDialogId}
                aria-haspopup="dialog"
              >
                <TextAlignStart aria-hidden="true" />
                Abstract
              </button>
            )}
            {publication.bibtexShow && (
              <button
                type="button"
                class="publication-link publication-link--button"
                data-dialog-open={dialogId}
                aria-haspopup="dialog"
              >
                <Braces aria-hidden="true" />
                BibTeX
              </button>
            )}
          </div>
        )}
      </div>
    )}
    {showAbstractButton && (
      <dialog
        id={abstractDialogId}
        class="publication-dialog publication-abstract-dialog"
        aria-labelledby={`${abstractDialogId}-title`}
      >
        <div class="publication-dialog__header">
          <div class="publication-dialog__heading">
            <p class="publication-dialog__kicker">Abstract</p>
            <p class="publication-dialog__title" id={`${abstractDialogId}-title`}>{publication.title}</p>
          </div>
          <button type="button" class="publication-dialog__close" data-dialog-close aria-label="Close">
            <X aria-hidden="true" />
          </button>
        </div>
        <div class="publication-dialog__body">
          {abstractHtml ? <p set:html={abstractHtml} /> : <p>{publication.abstract}</p>}
        </div>
      </dialog>
    )}
    {publication.bibtexShow && (
      <dialog id={dialogId} class="publication-dialog bibtex-dialog" aria-labelledby={`${dialogId}-title`}>
        <div class="publication-dialog__header">
          <div class="publication-dialog__heading">
            <p class="publication-dialog__kicker">BibTeX</p>
            <p class="publication-dialog__title" id={`${dialogId}-title`}>{publication.title}</p>
          </div>
          <button type="button" class="publication-dialog__close" data-dialog-close aria-label="Close">
            <X aria-hidden="true" />
          </button>
        </div>
        <div class="publication-dialog__body">
          <pre class="bibtex-dialog__code"><code>{bibtexLines.map((line) => <span class="bibtex-dialog__line">{line || " "}</span>)}</code></pre>
        </div>
        <div class="publication-dialog__footer">
          <button type="button" class="bibtex-dialog__copy" data-bib-copy>
            <Copy class="bibtex-dialog__icon bibtex-dialog__icon--copy" aria-hidden="true" />
            <Check class="bibtex-dialog__icon bibtex-dialog__icon--done" aria-hidden="true" />
            <span data-bib-copy-label aria-live="polite">Copy BibTeX</span>
          </button>
        </div>
      </dialog>
    )}
  </div>
</article>

<script>
  // Idempotently wire up publication dialog openers, closers, and copy buttons
  // across every PublicationItem on the page. Re-running this is a no-op.
  function wirePublicationDialogs(scope: ParentNode = document) {
    for (const trigger of scope.querySelectorAll<HTMLButtonElement>(
      "[data-dialog-open]:not([data-publication-dialog-wired])"
    )) {
      trigger.dataset.publicationDialogWired = "true";
      trigger.addEventListener("click", () => {
        const id = trigger.getAttribute("data-dialog-open");
        if (!id) return;
        const dialog = document.getElementById(id) as HTMLDialogElement | null;
        dialog?.showModal();
      });
    }
    for (const closer of scope.querySelectorAll<HTMLButtonElement>(
      "[data-dialog-close]:not([data-publication-dialog-wired])"
    )) {
      closer.dataset.publicationDialogWired = "true";
      closer.addEventListener("click", () => {
        closer.closest("dialog")?.close();
      });
    }
    for (const copier of scope.querySelectorAll<HTMLButtonElement>(
      "[data-bib-copy]:not([data-publication-dialog-wired])"
    )) {
      copier.dataset.publicationDialogWired = "true";
      copier.addEventListener("click", () => {
        const code = copier.closest("dialog")?.querySelector("code");
        // Lines are block spans, whose textContent has no newlines: join them.
        const lines = code ? [...code.querySelectorAll(".bibtex-dialog__line")] : [];
        const text = lines.length
          ? lines.map((line) => line.textContent ?? "").join("\n").trim()
          : (code?.textContent?.trim() ?? "");
        const label = copier.querySelector("[data-bib-copy-label]");
        const finish = (message: string, copied: boolean) => {
          if (label) label.textContent = message;
          if (copied) copier.dataset.copied = "true";
          window.setTimeout(() => {
            if (label) label.textContent = "Copy BibTeX";
            delete copier.dataset.copied;
          }, 1600);
        };
        // Select the entry so the "Press ⌘C" fallback has something to copy.
        // `navigator.clipboard` is undefined outside a secure context.
        const fallBack = () => {
          if (code) window.getSelection()?.selectAllChildren(code);
          finish("Press ⌘C", false);
        };
        if (!navigator.clipboard) {
          fallBack();
          return;
        }
        navigator.clipboard
          .writeText(text)
          .then(() => finish("Copied", true))
          .catch(fallBack);
      });
    }
    for (const dialog of scope.querySelectorAll<HTMLDialogElement>(
      "dialog.publication-dialog:not([data-publication-dialog-wired])"
    )) {
      dialog.dataset.publicationDialogWired = "true";
      // Click on the backdrop (i.e., outside the inner content) closes the dialog.
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
  }
  wirePublicationDialogs();
</script>
