---
import { highlightBibtex, type BibtexToken } from "../../lib/publications/bibtexHighlight";

/**
 * A BibTeX record, coloured, for readers to check and copy. Used by the
 * entry footer's Cite section and by the publications BibTeX dialog, so
 * both look and behave the same.
 *
 * Long lines wrap rather than scroll, so nothing is hidden: each line hangs
 * under its own field, a field's `name = {` stays together, and a value
 * with no spaces (a URL, a DOI) breaks between any characters instead of
 * dropping to a line of its own. Copying uses the record as written
 * (`data-bibtex`), not the rendered text.
 */
type Props = {
  bibtex: string;
  /**
   * Show the copy icon in the block's corner. Off where the block sits in
   * a dialog with its own Copy BibTeX button (marked `data-bibtex-copy`,
   * inside an element marked `data-bibtex-scope`).
   */
  copyButton?: boolean;
};

const { bibtex, copyButton = true } = Astro.props;
const source = bibtex.trim();
const lines = highlightBibtex(source);
const last = lines.length - 1;

const tokenClass = (token: BibtexToken) =>
  token.kind === "value" && !/\s/.test(token.text)
    ? "bib-value bib-value--unbroken"
    : `bib-${token.kind}`;
---

{/* The <code> content is one line on purpose: inside <pre>, any whitespace
    between the expressions would be shown. Each line keeps its newline, so
    the rendered text (and a manual copy of a selection) is the record. */}
<div
  class:list={["bibtex-block", copyButton && "bibtex-block--copy"]}
  data-bibtex={source}
  data-bibtex-scope
>
  <pre class="bibtex-block__code"><code>{lines.map((line, index) => <span class="bibtex-block__line">{line.lead.length > 0 && <span class="bibtex-block__lead">{line.lead.map((token) => token.kind === "plain" ? token.text : <span class={tokenClass(token)}>{token.text}</span>)}</span>}{line.body.map((token) => token.kind === "plain" ? token.text : <span class={tokenClass(token)}>{token.text}</span>)}{index < last && "\n"}</span>)}</code></pre>
  {copyButton && (
    <button
      class="bibtex-block__copy"
      type="button"
      aria-label="Copy BibTeX"
      title="Copy BibTeX"
      data-bibtex-copy
    >
      {/* Lucide's Copy and Check, as the dialog's button uses; inline so
          the scoped styles reach them. */}
      <svg class="bibtex-block__icon bibtex-block__icon--copy" aria-hidden="true" viewBox="0 0 24 24">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
      </svg>
      <svg class="bibtex-block__icon bibtex-block__icon--done" aria-hidden="true" viewBox="0 0 24 24">
        <path d="M20 6 9 17l-5-5" />
      </svg>
      <span class="bibtex-block__status" data-bibtex-copy-label aria-live="polite"></span>
    </button>
  )}
</div>

<script>
  import { installBibtexCopy } from "../../lib/publications/copyBibtex";

  installBibtexCopy();
</script>

<style>
  .bibtex-block {
    position: relative;
    min-width: 0;
    background: var(--color-bg-soft);
    border-radius: 6px;
    padding: 12px 14px;
  }
  /* The record stops short of the corner icon, so no line runs under it. */
  .bibtex-block--copy {
    padding-right: 44px;
  }

  .bibtex-block__code,
  .bibtex-block__code code {
    margin: 0;
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-fg-soft);
    white-space: pre-wrap;
  }

  /* A wrapped line continues 2ch past its field name's indent. */
  .bibtex-block__line {
    display: block;
    padding-left: 4ch;
    text-indent: -4ch;
  }
  /* `pre`, not `nowrap`: the lead holds the line's indent, which `nowrap`
     would collapse. */
  .bibtex-block__lead {
    white-space: pre;
  }
  .bib-value--unbroken {
    word-break: break-all;
  }

  /* Syntax colours come from the theme tokens, so they follow dark mode. */
  .bib-type {
    color: var(--color-accent);
  }
  .bib-key {
    color: var(--color-fg);
  }
  .bib-field {
    color: var(--color-link);
  }
  .bib-punct {
    color: var(--color-muted);
  }
  .bib-value {
    color: var(--color-fg-soft);
  }

  /* An icon at rest, muted until the block is hovered; after a click it
     shows a short label beside the icon. */
  .bibtex-block__copy {
    position: absolute;
    top: 6px;
    right: 6px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px;
    font-family: var(--font-ui);
    font-size: 12px;
    line-height: 1;
    color: var(--color-muted);
    background: transparent;
    border: 0;
    border-radius: 5px;
    opacity: 0.7;
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s,
      opacity 0.15s;
  }
  .bibtex-block:hover .bibtex-block__copy,
  .bibtex-block__copy:focus-visible,
  .bibtex-block__copy[data-state] {
    opacity: 1;
  }
  .bibtex-block__copy:hover,
  .bibtex-block__copy[data-state] {
    color: var(--color-fg);
    background: var(--color-bg);
  }
  .bibtex-block__copy[data-state="done"] {
    color: var(--color-accent);
  }
  .bibtex-block__icon {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bibtex-block__icon--done {
    display: none;
  }
  .bibtex-block__copy[data-state="done"] .bibtex-block__icon--copy {
    display: none;
  }
  .bibtex-block__copy[data-state="done"] .bibtex-block__icon--done {
    display: block;
  }
  .bibtex-block__status:empty {
    display: none;
  }

  @media (max-width: 640px) {
    .bibtex-block {
      padding: 12px;
    }
    .bibtex-block--copy {
      padding-right: 40px;
    }
    .bibtex-block__code,
    .bibtex-block__code code {
      font-size: 12px;
    }
  }
</style>
