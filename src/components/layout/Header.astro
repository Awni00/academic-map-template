---
import ThemeToggle from "./ThemeToggle";
import { siteConfig } from "../../config/site";
import { themeConfig } from "../../config/theme";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/">{siteConfig.name}</a>
    <nav class="site-nav" aria-label="Primary navigation">
      <div class="site-nav__links">
        {
          siteConfig.nav.map((item) => {
            const href = item.href.replace(/\/$/, "") || "/";
            const isCurrent = currentPath === href || (href !== "/" && currentPath.startsWith(`${href}/`));
            return (
              <a href={item.href} aria-current={isCurrent ? "page" : undefined}>
                {item.label}
              </a>
            );
          })
        }
      </div>
      {themeConfig.allowToggle && <ThemeToggle client:load />}
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const header = document.querySelector(".site-header");
    if (!header) return;

    const updateHeaderHeight = () => {
      root.style.setProperty("--site-header-height", `${header.getBoundingClientRect().height}px`);
    };

    updateHeaderHeight();

    // On phones the nav is one line that scrolls sideways (globals.css). Start
    // it with the current page's link in view, not wherever the list begins.
    const links = header.querySelector(".site-nav__links");
    const current = links?.querySelector('a[aria-current="page"]');
    if (links && current && links.scrollWidth > links.clientWidth) {
      links.scrollLeft +=
        current.getBoundingClientRect().left - links.getBoundingClientRect().left - 12;
    }

    if ("ResizeObserver" in window) {
      const observer = new ResizeObserver(updateHeaderHeight);
      observer.observe(header);
      return;
    }

    window.addEventListener("resize", updateHeaderHeight, { passive: true });
  })();
</script>
