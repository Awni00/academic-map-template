---
import { siteConfig } from "../../config/site";
import { rssFeed } from "../../lib/routes/paths";

const feed = rssFeed();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>© {new Date().getFullYear()} · {siteConfig.name}</div>
    <div>
      Built with the <a href="https://github.com/" rel="noopener">academic-graph</a>
      template · <a href="https://github.com/" rel="noopener">source</a>
      {feed && <> · <a href={feed.href}>RSS</a></>}
    </div>
  </div>
</footer>
