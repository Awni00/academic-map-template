---
import { CALLOUT_ROLE_COLORS, type CalloutRole } from "./calloutRoles";

type Props = {
  /** Visible environment label, e.g. "Definition", "Lemma", or "Assumption". */
  label?: string;
  /** Optional descriptive title shown in parentheses next to the label. */
  title?: string;
  /** Anchor id for in-document links. */
  id?: string;
  /**
   * Accent color for the label, title, and left border: a palette role
   * (`accent`, `fg`, `muted`, or a callout role — `info`, `success`,
   * `warning`, `danger`, `example`, `quote`) or any CSS color. A role follows
   * the site's theme in light and dark; a literal color does not.
   */
  accent?: string;
};

const { label, title, id, accent } = Astro.props;
const displayLabel = label ?? "Statement";
// The label and title are text, so a callout role maps to its text token
// (held to 4.5:1), which also serves for the border.
const accentTokens: Record<string, string> = {
  ...Object.fromEntries(
    (Object.keys(CALLOUT_ROLE_COLORS) as CalloutRole[]).map((role) => [role, CALLOUT_ROLE_COLORS[role].text])
  ),
  fg: "var(--color-fg)",
  muted: "var(--color-muted)"
};
const resolvedAccent = accent ? (accentTokens[accent] ?? accent) : undefined;
const accentStyle = resolvedAccent ? `--statement-accent: ${resolvedAccent};` : undefined;
---

<section class="statement" id={id} style={accentStyle}>
  <div class="statement-head">
    <span class="statement-label">{displayLabel}</span>
    {title && <span class="statement-title">({title})</span>}
  </div>
  <div class="statement-body">
    <slot />
  </div>
</section>
