---
import { buildMediaLayoutStyle, type MediaLayoutProps } from "./mediaLayout";

type Props = {
  /**
   * Visible text before the tabs, such as "Question". It names the tab list
   * for screen readers too, so it takes precedence over `ariaLabel`. Hidden
   * on phones, where the tabs need the room.
   */
  label?: string;
  /** The tab list's accessible name when there is no `label`. */
  ariaLabel?: string;
  /**
   * Where the tab bar, with its label, sits across the figure's width.
   * Tabs wider than the column still scroll from the first one.
   */
  align?: "start" | "center" | "end";
  defaultValue?: string;
  class?: string;
  style?: string;
} & MediaLayoutProps;

const {
  label,
  ariaLabel = "Figure variants",
  align = "start",
  defaultValue,
  class: className,
  style,
  width,
  maxWidth,
  mediaWidth,
  mediaMaxWidth,
  mediaHeight,
  mediaMaxHeight,
  mediaAspectRatio,
  mediaFit,
  mediaInset,
  mediaAlign
} = Astro.props;
const layoutStyle = buildMediaLayoutStyle(
  {
    width,
    maxWidth,
    mediaWidth,
    mediaMaxWidth,
    mediaHeight,
    mediaMaxHeight,
    mediaAspectRatio,
    mediaFit,
    mediaInset,
    mediaAlign
  },
  { style }
);
---

<div
  class:list={["toggle-figure", className]}
  style={layoutStyle}
  data-toggle-figure
  data-aria-label={ariaLabel}
  data-default-value={defaultValue}
  data-align={align === "start" ? undefined : align}
>
  <div class="toggle-figure__controls" data-toggle-figure-controls hidden>
    {label && <span class="toggle-figure__label" data-toggle-figure-label>{label}</span>}
  </div>
  <div class="toggle-figure__panels" data-toggle-figure-panels>
    <slot />
  </div>
</div>

<script>
  import { wireOverflowHints } from "../../lib/article/overflowHint";

  const SELECTORS = {
    root: "[data-toggle-figure]",
    controls: "[data-toggle-figure-controls]",
    label: "[data-toggle-figure-label]",
    panel: "[data-toggle-figure-panel]"
  };

  function wireToggleFigures(scope: ParentNode = document) {
    for (const root of scope.querySelectorAll<HTMLElement>(SELECTORS.root)) {
      if (root.dataset.toggleFigureReady === "true") continue;
      root.dataset.toggleFigureReady = "true";

      const controls = root.querySelector<HTMLElement>(SELECTORS.controls);
      const panels = Array.from(root.querySelectorAll<HTMLElement>(SELECTORS.panel));
      if (!controls || panels.length === 0) continue;

      const tablist = document.createElement("div");
      const rootIndex = Array.from(document.querySelectorAll(SELECTORS.root)).indexOf(root);
      tablist.className = "toggle-figure__tablist";
      tablist.setAttribute("role", "tablist");
      // A visible label names the tab list; otherwise `ariaLabel` does.
      const heading = controls.querySelector<HTMLElement>(SELECTORS.label);
      if (heading) {
        heading.id = `toggle-figure-${rootIndex}-label`;
        tablist.setAttribute("aria-labelledby", heading.id);
      } else {
        tablist.setAttribute("aria-label", root.dataset.ariaLabel || "Figure variants");
      }

      const buttons = panels.map((panel, index) => {
        const label = panel.dataset.label || `Figure ${index + 1}`;
        const value = panel.dataset.value || `panel-${index + 1}`;
        const tabId = `toggle-figure-${rootIndex}-tab-${index}`;
        const panelId = `toggle-figure-${rootIndex}-panel-${index}`;
        const button = document.createElement("button");

        panel.dataset.value = value;
        panel.id ||= panelId;
        panel.setAttribute("role", "tabpanel");
        panel.setAttribute("aria-labelledby", tabId);

        button.id = tabId;
        button.type = "button";
        button.className = "toggle-figure__tab";
        button.textContent = label;
        button.setAttribute("role", "tab");
        button.setAttribute("aria-controls", panel.id);
        button.addEventListener("click", () => selectPanel(index, true));
        button.addEventListener("keydown", (event) => {
          const nextIndex = getNextIndex(event.key, index, buttons.length);
          if (nextIndex === null) return;
          event.preventDefault();
          selectPanel(nextIndex, true);
        });

        tablist.append(button);
        return button;
      });

      const selectPanel = (activeIndex: number, focusButton = false) => {
        panels.forEach((panel, index) => {
          const isActive = index === activeIndex;
          panel.dataset.active = isActive ? "true" : "false";
          panel.setAttribute("aria-hidden", isActive ? "false" : "true");
          panel.inert = !isActive;
        });
        buttons.forEach((button, index) => {
          const isActive = index === activeIndex;
          button.setAttribute("aria-selected", isActive ? "true" : "false");
          button.tabIndex = isActive ? 0 : -1;
        });
        if (focusButton) buttons[activeIndex]?.focus();
      };

      controls.replaceChildren(...(heading ? [heading] : []), tablist);
      controls.hidden = panels.length < 2;
      // Tabs wider than the column scroll; fade the edge that hides some.
      wireOverflowHints(SELECTORS.controls, root);
      root.dataset.toggleFigureEnhanced = "true";

      const defaultIndex = panels.findIndex((panel) => panel.dataset.value === root.dataset.defaultValue);
      selectPanel(defaultIndex >= 0 ? defaultIndex : 0);
    }
  }

  function getNextIndex(key: string, currentIndex: number, count: number) {
    if (key === "ArrowRight" || key === "ArrowDown") return (currentIndex + 1) % count;
    if (key === "ArrowLeft" || key === "ArrowUp") return (currentIndex - 1 + count) % count;
    if (key === "Home") return 0;
    if (key === "End") return count - 1;
    return null;
  }

  wireToggleFigures();
</script>
