---
import { buildMediaLayoutStyle, type MediaLayoutProps } from "./mediaLayout";
import { renderCaption } from "./caption";

type Props = {
  src: string;
  alt?: string;
  poster?: string;
  caption?: string;
  class?: string;
  style?: string;
} & MediaLayoutProps;

const {
  src,
  alt = "3D model",
  poster,
  caption,
  class: className,
  style,
  width,
  maxWidth,
  mediaWidth,
  mediaMaxWidth,
  mediaHeight,
  mediaMaxHeight,
  mediaAspectRatio,
  mediaFit,
  mediaInset,
  mediaAlign
} = Astro.props;
const layoutStyle = buildMediaLayoutStyle(
  {
    width,
    maxWidth,
    mediaWidth,
    mediaMaxWidth,
    mediaHeight,
    mediaMaxHeight,
    mediaAspectRatio,
    mediaFit,
    mediaInset,
    mediaAlign
  },
  { style }
);
---

<figure class:list={["article-figure", className]} style={layoutStyle}>
  <div class="article-figure__body">
    <div class="model-viewer">
      <p><a href={src}>Open 3D model</a></p>
      {poster && <img src={poster} alt={alt} loading="lazy" />}
    </div>
  </div>
  {caption && <figcaption set:html={renderCaption(caption)} />}
</figure>
