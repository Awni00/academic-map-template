---
import Statement from "./Statement.astro";

type Props = {
  /** Visible environment label, e.g. "Theorem 1" or "Definition". Defaults to "Theorem". */
  label?: string;
  /** Optional descriptive title shown in parentheses next to the label. */
  title?: string;
  /** Anchor id for in-document links. */
  id?: string;
  /** Accent color for the label, title, and left border: a palette role (see Statement) or any CSS color. */
  accent?: string;
};

const { label, title, id, accent } = Astro.props;
---

<Statement label={label ?? "Theorem"} title={title} id={id} accent={accent}>
  <slot />
</Statement>
