---
import { Picture as AstroPicture } from "astro:assets";

import { isPdfSource, renderPdfFirstPage } from "../../lib/article/pdf";
import { buildMediaLayoutStyle, type MediaLayoutProps } from "./mediaLayout";

type Props = {
  src?: string | ImageMetadata;
  alt: string;
  class?: string;
  style?: string;
  priority?: boolean;
  invertInDarkMode?: boolean;
  lightSrc?: string;
  darkSrc?: string;
} & MediaLayoutProps;

const {
  src,
  alt,
  class: classNameProp,
  style,
  priority = false,
  invertInDarkMode = false,
  lightSrc,
  darkSrc,
  width,
  maxWidth,
  mediaWidth,
  mediaMaxWidth,
  mediaHeight,
  mediaMaxHeight,
  mediaAspectRatio,
  mediaFit,
  mediaInset,
  mediaAlign
} = Astro.props;

const loading = priority ? "eager" : "lazy";
const decoding = priority ? "sync" : "async";
const fetchpriority = priority ? "high" : "auto";
const fullClassName = [
  "article-picture",
  invertInDarkMode ? "invert-in-dark" : "",
  classNameProp
].filter(Boolean).join(" ");
const layoutStyle = buildMediaLayoutStyle(
  {
    width,
    maxWidth,
    mediaWidth,
    mediaMaxWidth,
    mediaHeight,
    mediaMaxHeight,
    mediaAspectRatio,
    mediaFit,
    mediaInset,
    mediaAlign
  },
  { style, directMedia: true }
);
const renderedPdf = isPdfSource(src)
  ? await renderPdfFirstPage(src, { emitToDist: import.meta.env.PROD })
  : undefined;
---

{
  lightSrc && darkSrc ? (
    // Art-directed pair. The swap is driven by `data-theme` from
    // `window.__applyTheme` (see BaseLayout) rather than a
    // `media="(prefers-color-scheme: dark)"` source, because that media query
    // tracks the operating system and would ignore the site's own toggle.
    // Only one of the two is ever fetched, unlike a CSS show/hide pair.
    <img
      class={fullClassName}
      style={layoutStyle}
      src={lightSrc}
      data-light-src={lightSrc}
      data-dark-src={darkSrc}
      alt={alt}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
    />
  ) : renderedPdf ? (
    <img
      class={fullClassName}
      style={layoutStyle}
      src={renderedPdf.src}
      width={renderedPdf.width}
      height={renderedPdf.height}
      alt={alt}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
    />
  ) : typeof src === "object" ? (
    <AstroPicture
      class={fullClassName}
      style={layoutStyle}
      src={src}
      alt={alt}
      layout="constrained"
      formats={["avif"]}
      priority={priority}
      fit="scale-down"
    />
  ) : (
    <img
      class={fullClassName}
      style={layoutStyle}
      src={src}
      alt={alt}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
    />
  )
}
