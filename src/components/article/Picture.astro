---
import { Picture as AstroPicture } from "astro:assets";

import { isPdfSource, renderPdfFirstPage } from "../../lib/article/pdf";
import { publicImageSize } from "../../lib/article/publicImage";
import { buildMediaLayoutStyle, type MediaLayoutProps } from "./mediaLayout";

type Props = {
  src?: string | ImageMetadata;
  alt: string;
  class?: string;
  style?: string;
  priority?: boolean;
  invertInDarkMode?: boolean;
  lightSrc?: string;
  darkSrc?: string;
} & MediaLayoutProps;

const {
  src,
  alt,
  class: classNameProp,
  style,
  priority = false,
  invertInDarkMode = false,
  lightSrc,
  darkSrc,
  width,
  maxWidth,
  mediaWidth,
  mediaMaxWidth,
  mediaHeight,
  mediaMaxHeight,
  mediaAspectRatio,
  mediaFit,
  mediaInset,
  mediaAlign
} = Astro.props;

const loading = priority ? "eager" : "lazy";
const decoding = priority ? "sync" : "async";
const fetchpriority = priority ? "high" : "auto";
const fullClassName = [
  "article-picture",
  invertInDarkMode ? "invert-in-dark" : "",
  classNameProp
].filter(Boolean).join(" ");
const renderedPdf = isPdfSource(src)
  ? await renderPdfFirstPage(src, { emitToDist: import.meta.env.PROD })
  : undefined;
// Reserve a lazy image's box before it loads, so the caption doesn't sit
// under a sliver and jump when the image arrives. Two things stood in the
// way. The stylesheet sets `aspect-ratio` from a variable, which overrides the
// ratio the browser takes from the width/height attributes, so the ratio is
// stated here (`auto` still defers to the loaded image). And Astro's
// <picture> wrapper shrink-wraps its image, which has no width until it
// loads, so the wrapper steps out of layout (`display: contents`) and the
// image is capped at its natural width directly — the size the wrapper used
// to give it once loaded.
// A path string under `public/` has no import metadata, so its size is read
// from the file instead (an art-directed pair is sized by its light image;
// the two are expected to match).
const pathSize =
  renderedPdf || typeof src === "object" ? undefined : await publicImageSize(lightSrc && darkSrc ? lightSrc : src);
const intrinsic = renderedPdf ?? (typeof src === "object" ? src : pathSize);
const reservedAspectRatio =
  intrinsic?.width && intrinsic?.height ? `auto ${intrinsic.width} / ${intrinsic.height}` : undefined;
const naturalMaxWidth = typeof src === "object" && src.width ? `${src.width}px` : undefined;
const layoutStyle = buildMediaLayoutStyle(
  {
    width,
    maxWidth,
    mediaWidth,
    mediaMaxWidth,
    mediaHeight,
    mediaMaxHeight,
    mediaAspectRatio,
    mediaFit,
    mediaInset,
    mediaAlign
  },
  {
    style,
    directMedia: true,
    defaults: { mediaAspectRatio: reservedAspectRatio, mediaMaxWidth: naturalMaxWidth }
  }
);
---

{
  lightSrc && darkSrc ? (
    // Art-directed pair. The swap is driven by `data-theme` from
    // the theme bootstrap in BaseLayout rather than a
    // `media="(prefers-color-scheme: dark)"` source, because that media query
    // tracks the operating system and would ignore the site's own toggle.
    // Only one of the two is ever fetched, unlike a CSS show/hide pair.
    <img
      class={fullClassName}
      style={layoutStyle}
      src={lightSrc}
      data-light-src={lightSrc}
      data-dark-src={darkSrc}
      width={pathSize?.width}
      height={pathSize?.height}
      alt={alt}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
    />
  ) : renderedPdf ? (
    <img
      class={fullClassName}
      style={layoutStyle}
      src={renderedPdf.src}
      width={renderedPdf.width}
      height={renderedPdf.height}
      alt={alt}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
    />
  ) : typeof src === "object" ? (
    <AstroPicture
      class={fullClassName}
      style={layoutStyle}
      src={src}
      alt={alt}
      pictureAttributes={{ style: "display: contents" }}
      layout="constrained"
      formats={["avif"]}
      priority={priority}
      fit="scale-down"
    />
  ) : (
    <img
      class={fullClassName}
      style={layoutStyle}
      src={src}
      width={pathSize?.width}
      height={pathSize?.height}
      alt={alt}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
    />
  )
}
