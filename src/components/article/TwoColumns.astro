---
import { buildMediaLayoutStyle } from "./mediaLayout";
import { renderCaption } from "./caption";

type Props = {
  class?: string;
  style?: string;
  width?: string;
  maxWidth?: string;
  gap?: string;
  align?: "start" | "center" | "end" | "stretch";
  /**
   * A caption under both columns (inline markdown allowed), or use the
   * `caption` slot. With one, the pair renders as a single <figure>. For two
   * images side by side, prefer `FigureGrid`, which also sizes their frames.
   */
  caption?: string;
};

const {
  class: className,
  style,
  width,
  maxWidth,
  gap,
  align,
  caption
} = Astro.props;
const hasNamedColumns = Astro.slots.has("left") || Astro.slots.has("right");
const hasCaptionSlot = Astro.slots.has("caption");
const hasCaption = hasCaptionSlot || Boolean(caption);
const layoutStyle = buildMediaLayoutStyle(
  { width, maxWidth },
  {
    style,
    extraVars: {
      "--two-columns-gap": gap,
      "--two-columns-align": align
    }
  }
);
---

{
  hasCaption ? (
    <figure class:list={["two-columns-figure", className]} style={layoutStyle}>
      <div class="two-columns">
        {hasNamedColumns ? (
          <>
            <div class="two-columns__column">
              <slot name="left" />
            </div>
            <div class="two-columns__column">
              <slot name="right" />
            </div>
          </>
        ) : (
          <slot />
        )}
      </div>
      {hasCaptionSlot ? (
        <figcaption>
          <slot name="caption" />
        </figcaption>
      ) : (
        <figcaption set:html={renderCaption(caption!)} />
      )}
    </figure>
  ) : (
    <div class:list={["two-columns", className]} style={layoutStyle}>
      {hasNamedColumns ? (
        <>
          <div class="two-columns__column">
            <slot name="left" />
          </div>
          <div class="two-columns__column">
            <slot name="right" />
          </div>
        </>
      ) : (
        <slot />
      )}
    </div>
  )
}
