---
import { writingConfig } from "../../config";
import LocalGraphMap from "../graph/LocalGraphMap";
import {
  DEFAULT_TOC_CONFIG,
  filterHeadingsForToc,
  type TocHeading
} from "../../lib/article/toc";
import type { GraphIndex } from "../../lib/graph/types";
import type { TocConfig } from "../../config/types";

type Heading = TocHeading;
type LinkedItem = { id: string; title: string; url: string };

type Props = {
  graph: GraphIndex;
  currentId: string;
  /** TOC headings; rendered only if `tocInFoot` is true. */
  headings?: Heading[];
  tocConfig?: TocConfig;
  tocInFoot?: boolean;
  showLocalGraph?: boolean;
  linkedFrom?: LinkedItem[];
  related?: LinkedItem[];
  bibtex?: string;
};

const {
  graph,
  currentId,
  headings = [],
  tocConfig = DEFAULT_TOC_CONFIG,
  tocInFoot = false,
  showLocalGraph = false,
  linkedFrom = [],
  related = [],
  bibtex
} = Astro.props;

const tocHeadings = tocInFoot ? filterHeadingsForToc(headings, tocConfig) : [];
// The linked-from and related lists are suppressed when the map is shown: it already
// draws those relationships, and `related` is the union of linksTo links and
// linkedFrom, so the two lists also duplicated each other.
const showLinkLists = !showLocalGraph;
const hasAny =
  (tocInFoot && tocHeadings.length > 0) ||
  showLocalGraph ||
  (showLinkLists && (linkedFrom.length > 0 || related.length > 0)) ||
  Boolean(bibtex);
---

{
  hasAny && (
    <section class="entry-foot" aria-label="Page navigation">
      {tocInFoot && tocHeadings.length > 0 && (
        <div class="entry-foot-section">
          <div class="entry-foot-label">On this page</div>
          <div class="entry-foot-content">
            <ul>
              {tocHeadings.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
      {showLocalGraph && (
        <div class="entry-foot-section">
          <div class="entry-foot-label">Related</div>
          <div class="entry-foot-content">
            <LocalGraphMap
              client:load
              graph={graph}
              currentId={currentId}
              depth={writingConfig.entryLayout.localGraph.defaultDepth as 1 | 2}
              maxNodes={writingConfig.entryLayout.localGraph.maxNodes}
            />
          </div>
        </div>
      )}
      {showLinkLists && linkedFrom.length > 0 && (
        <div class="entry-foot-section">
          <div class="entry-foot-label">Linked from</div>
          <div class="entry-foot-content">
            <ul>
              {linkedFrom.map((item) => (
                <li>
                  <a href={item.url}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
      {showLinkLists && related.length > 0 && (
        <div class="entry-foot-section">
          <div class="entry-foot-label">Related</div>
          <div class="entry-foot-content">
            <ul>
              {related.map((item) => (
                <li>
                  <a href={item.url}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
      {bibtex && (
        <div class="entry-foot-section entry-foot-section--cite">
          <div class="entry-foot-label">Cite</div>
          <div class="entry-foot-content">
            <div class="cite-body">
              <pre class="cite-body__code"><code>{bibtex}</code></pre>
              <button class="cite-body__copy" type="button">Copy</button>
            </div>
          </div>
        </div>
      )}
    </section>
  )
}

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".cite-body__copy")) {
    button.addEventListener("click", () => {
      const body = button.closest(".cite-body");
      const text = body?.querySelector("code")?.textContent?.trim() ?? "";
      const original = button.textContent;
      const finish = (label: string) => {
        button.textContent = label;
        window.setTimeout(() => {
          button.textContent = original;
        }, 1200);
      };
      navigator.clipboard
        .writeText(text)
        .then(() => finish("Copied"))
        .catch(() => finish("Press ⌘C"));
    });
  }
</script>

<style>
  .cite-body {
    position: relative;
    min-width: 0;
    background: var(--color-bg-soft);
    border-radius: 6px;
    padding: 12px 44px 12px 14px;
  }
  .cite-body__code {
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    font-family: var(--font-mono);
    font-size: var(--article-caption-size, 13px);
    line-height: 1.6;
    color: var(--color-fg-soft);
    white-space: pre-wrap;
    word-break: normal;
    overflow-wrap: anywhere;
  }
  .cite-body__copy {
    position: absolute;
    top: 6px;
    right: 6px;
    font-family: var(--font-ui);
    font-size: var(--article-label-size, 12px);
    color: var(--color-muted);
    background: var(--color-bg);
    border: 0.5px solid var(--color-border);
    border-radius: 3px;
    padding: 3px 8px;
    cursor: pointer;
  }
  .cite-body__copy:hover {
    color: var(--color-fg);
    border-color: var(--color-rule);
  }
</style>
