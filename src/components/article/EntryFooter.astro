---
import { writingConfig } from "../../config";
import LocalGraphMap from "../graph/LocalGraphMap";
import {
  DEFAULT_TOC_CONFIG,
  filterHeadingsForToc,
  type TocHeading
} from "../../lib/article/toc";
import type { GraphIndex } from "../../lib/graph/types";
import type { TocConfig } from "../../config/types";
import type { RelatedItem } from "../../lib/article/related";
import { highlightBibtex } from "../../lib/article/bibtexHighlight";

type Heading = TocHeading;

type Props = {
  graph: GraphIndex;
  currentId: string;
  /** TOC headings; rendered only if `tocInFoot` is true. */
  headings?: Heading[];
  tocConfig?: TocConfig;
  tocInFoot?: boolean;
  showLocalGraph?: boolean;
  /**
   * The "Related" list. The layout passes it only when it should render
   * (see `showRelatedList`); with the map also shown, it sits under the map
   * in the same section.
   */
  related?: RelatedItem[];
  bibtex?: string;
};

const {
  graph,
  currentId,
  headings = [],
  tocConfig = DEFAULT_TOC_CONFIG,
  tocInFoot = false,
  showLocalGraph = false,
  related = [],
  bibtex
} = Astro.props;

const bibtexTokens = bibtex ? highlightBibtex(bibtex) : [];
const tocHeadings = tocInFoot ? filterHeadingsForToc(headings, tocConfig) : [];
const hasAny =
  (tocInFoot && tocHeadings.length > 0) ||
  showLocalGraph ||
  related.length > 0 ||
  Boolean(bibtex);
---

{
  hasAny && (
    <section class="entry-foot" aria-label="Page navigation">
      {tocInFoot && tocHeadings.length > 0 && (
        <div class="entry-foot-section">
          <div class="entry-foot-label">On this page</div>
          <div class="entry-foot-content">
            <ul>
              {tocHeadings.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
      {(showLocalGraph || related.length > 0) && (
        <div class="entry-foot-section">
          <div class="entry-foot-label">Related</div>
          <div class="entry-foot-content">
            {showLocalGraph && (
              <LocalGraphMap
                client:load
                graph={graph}
                currentId={currentId}
                depth={writingConfig.entryLayout.localGraph.defaultDepth as 1 | 2}
                maxNodes={writingConfig.entryLayout.localGraph.maxNodes}
              />
            )}
            {related.length > 0 && (
              <ul class="entry-foot-related">
                {related.map((item) => (
                  <li>
                    <a href={item.url}>{item.title}</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      )}
      {bibtex && (
        <div class="entry-foot-section entry-foot-section--cite">
          <div class="entry-foot-label">Cite</div>
          <div class="entry-foot-content">
            <div class="cite-body">
              <pre class="cite-body__code"><code>{bibtexTokens.map((token) => token.kind === "plain" ? token.text : <span class={`bib-${token.kind}`}>{token.text}</span>)}</code></pre>
              <button
                class="cite-body__copy"
                type="button"
                aria-label="Copy BibTeX"
                title="Copy BibTeX"
              >
                <svg class="cite-body__icon cite-body__icon--copy" aria-hidden="true" viewBox="0 0 16 16">
                  <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                  <path d="M10.5 5.5V3.5a1.5 1.5 0 0 0-1.5-1.5H3.5A1.5 1.5 0 0 0 2 3.5V9a1.5 1.5 0 0 0 1.5 1.5h2" />
                </svg>
                <svg class="cite-body__icon cite-body__icon--done" aria-hidden="true" viewBox="0 0 16 16">
                  <path d="M3 8.5l3 3 7-7" />
                </svg>
                <span class="cite-body__status" aria-live="polite"></span>
              </button>
            </div>
          </div>
        </div>
      )}
    </section>
  )
}

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".cite-body__copy")) {
    button.addEventListener("click", () => {
      const body = button.closest(".cite-body");
      const code = body?.querySelector("code");
      const text = code?.textContent?.trim() ?? "";
      const status = button.querySelector(".cite-body__status");
      // The button is an icon at rest; after a click it shows a short label
      // ("Copied", with a check mark, or "Press ⌘C") and then returns to it.
      const finish = (state: "done" | "fallback", label: string) => {
        button.dataset.state = state;
        if (status) status.textContent = label;
        window.clearTimeout(Number(button.dataset.timer));
        button.dataset.timer = String(
          window.setTimeout(() => {
            delete button.dataset.state;
            if (status) status.textContent = "";
          }, 1200)
        );
      };
      // Select the citation so the "Press ⌘C" fallback has something to copy.
      const fallBack = () => {
        if (code) window.getSelection()?.selectAllChildren(code);
        finish("fallback", "Press ⌘C");
      };
      // `navigator.clipboard` is undefined outside a secure context (such as
      // the dev server opened over a LAN address), so calling it directly
      // would throw before the promise could reject.
      if (!navigator.clipboard) {
        fallBack();
        return;
      }
      navigator.clipboard
        .writeText(text)
        .then(() => finish("done", "Copied"))
        .catch(fallBack);
    });
  }
</script>

<style>
  /* BibTeX keeps its own line breaks and indentation: a long field scrolls
     sideways (with an edge fade, from overflowHint.ts) rather than wrapping
     mid-value. The scroller stops short of the copy icon, so no line runs
     underneath it at any width. */
  .cite-body {
    position: relative;
    min-width: 0;
    background: var(--color-bg-soft);
    border-radius: 6px;
    padding: 12px 44px 12px 14px;
  }
  .cite-body__code {
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    font-family: var(--font-mono);
    font-size: var(--article-caption-size, 13px);
    line-height: 1.6;
    color: var(--color-fg-soft);
    white-space: pre;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-rule) transparent;
  }

  /* Syntax colours come from the theme tokens, so they follow dark mode. */
  .bib-type {
    color: var(--color-accent);
  }
  .bib-key {
    color: var(--color-fg);
  }
  .bib-field {
    color: var(--color-link);
  }
  .bib-punct {
    color: var(--color-muted);
  }
  .bib-value {
    color: var(--color-fg-soft);
  }

  /* An icon at rest, muted until the block is hovered; after a click it
     shows a short label beside the icon. */
  .cite-body__copy {
    position: absolute;
    top: 6px;
    right: 6px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px;
    font-family: var(--font-ui);
    font-size: var(--article-label-size, 12px);
    line-height: 1;
    color: var(--color-muted);
    background: transparent;
    border: 0;
    border-radius: 5px;
    opacity: 0.7;
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s,
      opacity 0.15s;
  }
  .cite-body:hover .cite-body__copy,
  .cite-body__copy:focus-visible,
  .cite-body__copy[data-state] {
    opacity: 1;
  }
  .cite-body__copy:hover,
  .cite-body__copy[data-state] {
    color: var(--color-fg);
    background: var(--color-bg);
  }
  .cite-body__copy[data-state="done"] {
    color: var(--color-accent);
  }
  .cite-body__icon {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cite-body__icon--done {
    stroke-width: 1.6;
    display: none;
  }
  .cite-body__copy[data-state="done"] .cite-body__icon--copy {
    display: none;
  }
  .cite-body__copy[data-state="done"] .cite-body__icon--done {
    display: block;
  }
  .cite-body__status:empty {
    display: none;
  }
</style>
