---
import { writingConfig } from "../../config";
import LocalGraphMap from "../graph/LocalGraphMap";
import {
  DEFAULT_TOC_CONFIG,
  filterHeadingsForToc,
  type TocHeading
} from "../../lib/article/toc";
import type { GraphIndex } from "../../lib/graph/types";
import type { TocConfig } from "../../config/types";

type Heading = TocHeading;
type LinkedItem = {
  id: string;
  title: string;
  url: string;
  date?: string;
  venue?: string;
  summary?: string;
  typeLabel?: string;
};

type Props = {
  graph: GraphIndex;
  currentId: string;
  /** TOC headings; rendered only if `tocInFoot` is true. */
  headings?: Heading[];
  tocConfig?: TocConfig;
  tocInFoot?: boolean;
  showLocalGraph?: boolean;
  linkedFrom?: LinkedItem[];
  related?: LinkedItem[];
  /** Show "Linked from" as cards with year, venue and summary (hub pages). */
  linkedFromAsCards?: boolean;
  bibtex?: string;
};

const {
  graph,
  currentId,
  headings = [],
  tocConfig = DEFAULT_TOC_CONFIG,
  tocInFoot = false,
  showLocalGraph = false,
  linkedFrom = [],
  related = [],
  linkedFromAsCards = false,
  bibtex
} = Astro.props;

// Cards lead with the newest work; undated pages (other hubs, notes) follow.
const cards = linkedFromAsCards
  ? [...linkedFrom].sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""))
  : [];
// "2024 · ICML 2024" says the year twice; a venue that names it stands alone.
const cardMeta = (item: LinkedItem) => {
  const year = item.date?.slice(0, 4);
  const parts = [year && !item.venue?.includes(year) ? year : undefined, item.venue].filter(Boolean);
  return parts.length > 0 ? parts.join(" · ") : item.typeLabel;
};

const tocHeadings = tocInFoot ? filterHeadingsForToc(headings, tocConfig) : [];
// The linked-from and related lists are suppressed when the map is shown: it already
// draws those relationships, and `related` is the union of linksTo links and
// linkedFrom, so the two lists also duplicated each other.
const showLinkLists = !showLocalGraph;
const hasAny =
  (tocInFoot && tocHeadings.length > 0) ||
  showLocalGraph ||
  (showLinkLists && (linkedFrom.length > 0 || related.length > 0)) ||
  Boolean(bibtex);
---

{
  hasAny && (
    <section class="entry-foot" aria-label="Page navigation">
      {tocInFoot && tocHeadings.length > 0 && (
        <div class="entry-foot-section">
          <div class="entry-foot-label">On this page</div>
          <div class="entry-foot-content">
            <ul>
              {tocHeadings.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
      {showLocalGraph && (
        <div class="entry-foot-section">
          <div class="entry-foot-label">Related</div>
          <div class="entry-foot-content">
            <LocalGraphMap
              client:load
              graph={graph}
              currentId={currentId}
              depth={writingConfig.entryLayout.localGraph.defaultDepth as 1 | 2}
              maxNodes={writingConfig.entryLayout.localGraph.maxNodes}
            />
          </div>
        </div>
      )}
      {showLinkLists && linkedFrom.length > 0 && (
        <div class="entry-foot-section">
          <div class="entry-foot-label">Linked from</div>
          <div class="entry-foot-content">
            {linkedFromAsCards ? (
              <ul class="entry-cards">
                {cards.map((item) => (
                  <li class="entry-card">
                    <a class="entry-card__link" href={item.url}>
                      {cardMeta(item) && <span class="entry-card__meta">{cardMeta(item)}</span>}
                      <span class="entry-card__title">{item.title}</span>
                      {item.summary && <span class="entry-card__summary">{item.summary}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <ul>
                {linkedFrom.map((item) => (
                  <li>
                    <a href={item.url}>{item.title}</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      )}
      {showLinkLists && related.length > 0 && (
        <div class="entry-foot-section">
          <div class="entry-foot-label">Related</div>
          <div class="entry-foot-content">
            <ul>
              {related.map((item) => (
                <li>
                  <a href={item.url}>{item.title}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
      {bibtex && (
        <div class="entry-foot-section entry-foot-section--cite">
          <div class="entry-foot-label">Cite</div>
          <div class="entry-foot-content">
            <div class="cite-body">
              <pre class="cite-body__code"><code>{bibtex}</code></pre>
              <button class="cite-body__copy" type="button">Copy</button>
            </div>
          </div>
        </div>
      )}
    </section>
  )
}

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".cite-body__copy")) {
    button.addEventListener("click", () => {
      const body = button.closest(".cite-body");
      const code = body?.querySelector("code");
      const text = code?.textContent?.trim() ?? "";
      const original = button.textContent;
      const finish = (label: string) => {
        button.textContent = label;
        window.setTimeout(() => {
          button.textContent = original;
        }, 1200);
      };
      // Select the citation so the "Press ⌘C" fallback has something to copy.
      const fallBack = () => {
        if (code) window.getSelection()?.selectAllChildren(code);
        finish("Press ⌘C");
      };
      // `navigator.clipboard` is undefined outside a secure context (such as
      // the dev server opened over a LAN address), so calling it directly
      // would throw before the promise could reject.
      if (!navigator.clipboard) {
        fallBack();
        return;
      }
      navigator.clipboard
        .writeText(text)
        .then(() => finish("Copied"))
        .catch(fallBack);
    });
  }
</script>

<style>
  /* Hub members. Scoped past `.entry-foot-content ul/li/a`, which lay out a
     plain link list: the whole card is the link, with no underline. */
  .entry-foot-content .entry-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 12px;
  }
  .entry-foot-content .entry-card {
    display: block;
  }
  .entry-foot-content .entry-card__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    box-sizing: border-box;
    padding: 12px 14px 14px;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-fg-soft);
    transition: border-color var(--dur-fast) var(--ease-quiet);
  }
  .entry-foot-content .entry-card__link:hover {
    border-color: var(--color-accent-line, var(--color-border));
  }
  .entry-foot-content .entry-card__link:hover .entry-card__title {
    color: var(--color-link);
  }
  .entry-card__meta {
    font-family: var(--font-mono);
    font-size: var(--article-label-size, 12px);
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  .entry-card__title {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-fg);
    text-wrap: balance;
  }
  .entry-card__summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    font-size: var(--article-caption-size, 13px);
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* BibTeX keeps its own line breaks and indentation: a long field scrolls
     sideways (with an edge fade, from overflowHint.ts) rather than wrapping
     mid-value. The scroller stops short of the Copy button, so no line runs
     underneath it. */
  .cite-body {
    position: relative;
    min-width: 0;
    background: var(--color-bg-soft);
    border-radius: 6px;
    padding: 12px 72px 12px 14px;
  }
  .cite-body__code {
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    font-family: var(--font-mono);
    font-size: var(--article-caption-size, 13px);
    line-height: 1.6;
    color: var(--color-fg-soft);
    white-space: pre;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }
  /* Phones: the button takes a row of its own above the record, and the
     record gets the full width. */
  @media (max-width: 680px) {
    .cite-body {
      padding: 40px 14px 12px;
    }
  }
  .cite-body__copy {
    position: absolute;
    top: 6px;
    right: 6px;
    font-family: var(--font-ui);
    font-size: var(--article-label-size, 12px);
    color: var(--color-muted);
    background: var(--color-bg);
    border: 0.5px solid var(--color-border);
    border-radius: 3px;
    padding: 3px 8px;
    cursor: pointer;
  }
  .cite-body__copy:hover {
    color: var(--color-fg);
    border-color: var(--color-rule);
  }
</style>
