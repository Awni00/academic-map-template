---
import { buildMediaLayoutStyle, type MediaLayoutProps } from "./mediaLayout";
import { renderCaption } from "./caption";
import Picture from "./Picture.astro";

type Props = {
  /**
   * The image, rendered through <Picture>, so a figure given `src` takes the
   * same image props as a Picture in its `figure` slot.
   */
  src?: string | ImageMetadata;
  alt?: string;
  /** Invert the image in dark mode (line art on a light background). */
  invertInDarkMode?: boolean;
  /** Art-directed light/dark pair, used together in place of `src`. */
  lightSrc?: string;
  darkSrc?: string;
  /** Load eagerly, for an image near the top of the page. */
  priority?: boolean;
  /**
   * What the figure holds, for numbered captions ("Table 2." rather than
   * "Figure 2."). Put a markdown table in the default slot with
   * `kind="table"`.
   */
  kind?: "figure" | "table";
  caption?: string;
  class?: string;
  style?: string;
} & MediaLayoutProps;

const {
  src,
  alt = "",
  invertInDarkMode,
  lightSrc,
  darkSrc,
  priority,
  kind,
  caption,
  class: className,
  style,
  width,
  maxWidth,
  mediaWidth,
  mediaMaxWidth,
  mediaHeight,
  mediaMaxHeight,
  mediaAspectRatio,
  mediaFit,
  mediaInset,
  mediaAlign
} = Astro.props;
const hasFigureSlot = Astro.slots.has("figure");
// A caption slot is rendered up front so that one which renders nothing (a
// wrapper forwarding a slot its own page never filled) leaves no empty
// <figcaption> and falls back to the `caption` prop.
const captionSlotHtml = Astro.slots.has("caption") ? (await Astro.slots.render("caption")).trim() : "";
const hasDefaultSlot = Astro.slots.has("default");
const hasImage = Boolean(src || (lightSrc && darkSrc));
const layoutStyle = buildMediaLayoutStyle(
  {
    width,
    maxWidth,
    mediaWidth,
    mediaMaxWidth,
    mediaHeight,
    mediaMaxHeight,
    mediaAspectRatio,
    mediaFit,
    mediaInset,
    mediaAlign
  },
  { style }
);
---

<figure
  class:list={["article-figure", className]}
  style={layoutStyle}
  data-kind={kind === "table" ? "table" : undefined}
>
  {
    hasFigureSlot || hasImage || hasDefaultSlot ? (
      <div class="article-figure__body">
        {
          hasFigureSlot ? (
            <slot name="figure" />
          ) : hasImage ? (
            <Picture
              src={src}
              alt={alt}
              invertInDarkMode={invertInDarkMode}
              lightSrc={lightSrc}
              darkSrc={darkSrc}
              priority={priority}
            />
          ) : (
            <slot />
          )
        }
      </div>
    ) : null
  }
  {
    captionSlotHtml ? (
      <figcaption set:html={captionSlotHtml} />
    ) : (
      caption && <figcaption set:html={renderCaption(caption)} />
    )
  }
</figure>
