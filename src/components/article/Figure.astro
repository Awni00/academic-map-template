---
import { buildMediaLayoutStyle, type MediaLayoutProps } from "./mediaLayout";
import { renderCaption } from "./caption";

type Props = {
  src?: string;
  alt?: string;
  caption?: string;
  class?: string;
  style?: string;
} & MediaLayoutProps;

const {
  src,
  alt = "",
  caption,
  class: className,
  style,
  width,
  maxWidth,
  mediaWidth,
  mediaMaxWidth,
  mediaHeight,
  mediaMaxHeight,
  mediaAspectRatio,
  mediaFit,
  mediaInset,
  mediaAlign
} = Astro.props;
const hasFigureSlot = Astro.slots.has("figure");
const hasCaptionSlot = Astro.slots.has("caption");
const hasDefaultSlot = Astro.slots.has("default");
const layoutStyle = buildMediaLayoutStyle(
  {
    width,
    maxWidth,
    mediaWidth,
    mediaMaxWidth,
    mediaHeight,
    mediaMaxHeight,
    mediaAspectRatio,
    mediaFit,
    mediaInset,
    mediaAlign
  },
  { style }
);
---

<figure class:list={["article-figure", className]} style={layoutStyle}>
  {
    hasFigureSlot || src || hasDefaultSlot ? (
      <div class="article-figure__body">
        {
          hasFigureSlot ? (
            <slot name="figure" />
          ) : src ? (
            <img class="article-picture" src={src} alt={alt} loading="lazy" />
          ) : (
            <slot />
          )
        }
      </div>
    ) : null
  }
  {
    hasCaptionSlot ? (
      <figcaption>
        <slot name="caption" />
      </figcaption>
    ) : (
      caption && <figcaption set:html={renderCaption(caption)} />
    )
  }
</figure>
